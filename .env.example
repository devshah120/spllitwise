# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/splitwise
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/splitwise?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/splitwise

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Google Sign-In
# Comma-separated list of accepted OAuth client IDs (the Web client ID for Android).
GOOGLE_CLIENT_IDS=

# Invite links / QR codes
# Deep-link scheme the mobile app registers.
APP_SCHEME=paisasplit
# Base URL for the invite link / QR payload: <INVITE_BASE_URL>/<code>
# In development use this machine's LAN IP so a phone can reach it;
# in production use your own https domain.
INVITE_BASE_URL=http://192.168.31.106:5000/join

# Public base URL used to build absolute upload URLs.
# Falls back to the request host when unset.
PUBLIC_BASE_URL=http://103.212.121.139:7000

# Outgoing mail (expense + settlement notifications)
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_FROM_NAME=PaisaSplit
SMTP_FROM_EMAIL=support@bondbyte.in
# Set to false to stop all outgoing notification mail.
MAIL_ENABLED=true
# Branding inside the message body and the "View in ..." button target.
MAIL_BRAND_NAME=PaisaSplit
MAIL_ACCENT_COLOR=#FF652F
MAIL_APP_URL=
